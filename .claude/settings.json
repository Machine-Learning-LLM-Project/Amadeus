{
  "enabledPlugins": {
    "expo@claude-plugins-official": true
  },
  "permissions": {
    "allow": [
      "Bash(npm run check)",
      "Bash(npm run check:secrets)",
      "Bash(npm run typecheck)",
      "Bash(npm run lint)",
      "Bash(npx tsc --noEmit)",
      "Bash(npx eslint .)",
      "Bash(npx expo-doctor)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.local)",
      "Read(./.env.*.local)",
      "Read(./.env.development)",
      "Read(./.env.production)",
      "Read(./supabase/.env)",
      "Read(./supabase/functions/.env)",
      "Edit(./.env)",
      "Edit(./.env.local)",
      "Edit(./.env.*.local)"
    ]
  }
}
